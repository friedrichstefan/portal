{
  "name": "frontend",
  "version": "0.0.0",
  "prettier": "@openmfp/config-prettier",
  "scripts": {
    "ng": "ng",
    "extract-versions": "node ./build-scripts/extract-versions.js",
    "prebuild": "npm run extract-versions",
    "prebuild:watch": "npm run extract-versions",
    "prestart": "npm run extract-versions",
    "prestart:watch": "npm run extract-versions",
    "start": "ng serve --port 4300",
    "start:watch": "nodemon",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/elements": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/localize": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-browser-dynamic": "22.1.4",
    "@angular/router": "22.1.4",
    "@luigi-project/client": "2.29.0",
    "@luigi-project/core": "2.29.0",
    "@luigi-project/plugin-auth-oauth2": "2.29.0",
    "@openmfp/portal-ui-lib": "0.195.11",
    "@platform-mesh/portal-ui-lib": "^0.63.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.14",
    "jsdom": "30.1.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "underscore": ">=1.13.8",
    "hono": "4.13.8",
    "http-proxy-middleware": "4.2.0",
    "brace-expansion": "5.0.12",
    "postcss": ">=8.5.18",
    "@openmfp/eslint-config-typescript": {
      "angular-eslint": "^22.1.0"
    }
