{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "prettier": "@openmfp/config-prettier",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 nest start",
    "start:watch": "NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --watch",
    "start:dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --watch",
    "start:debug": "NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/serve-static": "5.0.5",
    "@openmfp/portal-server-lib": "0.164.18",
    "@platform-mesh/portal-server-lib": "0.11.4",
    "axios": "1.18.0",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "graphql-request": "7.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.19",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.14",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "30.3.0",
    "jest-mock-extended": "4.0.0",
    "nock": "14.0.17",
    "prettier": "3.9.8",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "handlebars": ">=4.7.9",
    "form-data": "4.0.6",
    "hono": "4.13.8",
    "multer": "2.4.0",
    "undici": "8.10.2",
    "brace-expansion": "5.0.12"
  }
}
